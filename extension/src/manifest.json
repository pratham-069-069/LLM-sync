{
  "manifest_version": 3,
  "name": "LLM Sync",
  "version": "0.1.0",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://www.chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://deepseek.com/*",
    "https://chat.deepseek.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "src/background.ts"
  },
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://www.chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://deepseek.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["src/content-scripts/shared.ts"]
    }
  ]
}